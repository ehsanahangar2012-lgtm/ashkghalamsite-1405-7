# Site & Iran cPanel Ingestion Settings
SITE_BASE_URL=https://ashkghalam.ir
LOCAL_SERVER_URL=http://127.0.0.1:3000
AGENT_INGEST_SECRET=change-this-to-a-long-random-secret

# Free-Tier AI Providers (used server-side / in GitHub Actions only)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Quality Gate & Publishing Policy
AGENT_AUTO_PUBLISH=false
AGENT_MIN_PUBLISH_SCORE=82
AGENT_MIN_DRAFT_SCORE=60
AGENT_MIN_WORDS=550

# Search Engine Indexing
INDEXNOW_KEY=
GSC_SITE_URL=sc-domain:ashkghalam.ir
GSC_ACCESS_TOKEN=
