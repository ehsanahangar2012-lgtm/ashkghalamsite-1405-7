{
  "name": "ashk-ghalam-erp",
  "private": true,
  "version": "3.26.6",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js && npm run build:worker && node scripts/sync_graphify.cjs",
    "build:worker": "esbuild agent/worker.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/agent-worker.js",
    "version:bump": "node scripts/bump_version.cjs",
    "studio:install": "node scripts/install_offline_studios.cjs",
    "release:cpanel": "node scripts/bump_version.cjs && npm run build && node scripts/pack_release_zips.cjs",
    "start": "node dist/server.js",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "verify:dieline": "tsx scripts/verify-dieline-engines.ts",
    "verify:3d-caliper": "tsx scripts/verify-3d-board-caliper.ts",
    "verify:dxf-scale": "tsx scripts/verify-dxf-scale-warning.ts",
    "verify:cms-storage": "tsx scripts/verify-local-cms-storage.ts",
    "verify:all": "npm run verify:dieline && npm run verify:3d-caliper && npm run verify:dxf-scale && npm run verify:cms-storage",
    "graphify:update": "graphify update . && graphify cluster-only . --no-label",
    "graphify:watch": "graphify watch .",
    "graphify:benchmark": "graphify benchmark graphify-out/graph.json",
    "graphify:tree": "graphify tree --graph graphify-out/graph.json --output graphify-out/GRAPH_TREE.html"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1062.0",
    "@aws-sdk/s3-request-presigner": "^3.1062.0",
    "@fontsource/vazirmatn": "^5.0.0",
    "@google/genai": "^3.3.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/node-cron": "^3.0.11",
    "@types/three": "^0.185.1",
    "adm-zip": "^0.5.17",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "dxf-parser": "^1.1.2",
    "express": "^5.2.1",
    "firebase": "^12.15.0",
    "framer-motion": "^12.23.26",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.562.0",
    "node-cron": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pageflip": "^2.0.3",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  }
}
