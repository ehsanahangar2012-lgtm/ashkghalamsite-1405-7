{
  "name": "ashk-ghalam-erp",
  "private": true,
  "version": "3.25.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node -e \"const fs=require('fs'),path=require('path');for(const p of ['public/ashk-ghalam-erp-cpanel-release.zip','dist/ashk-ghalam-erp-cpanel-release.zip'])try{fs.unlinkSync(p)}catch{};for(const dir of ['public/downloads','dist'])try{for(const f of fs.readdirSync(dir))if(f.endsWith('.zip'))fs.unlinkSync(path.join(dir,f))}catch{}\" && vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js && npm run build:worker && node scripts/pack_release_zips.cjs",
    "build:worker": "esbuild agent/worker.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/agent-worker.js",
    "start": "node dist/server.js",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1062.0",
    "@aws-sdk/s3-request-presigner": "^3.1062.0",
    "@fontsource/vazirmatn": "^5.0.0",
    "@google/genai": "^3.3.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@types/node-cron": "^3.0.11",
    "@types/three": "^0.185.1",
    "adm-zip": "^0.5.17",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "dxf-parser": "^1.1.2",
    "express": "^5.2.1",
    "firebase": "^12.15.0",
    "framer-motion": "^12.23.26",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.562.0",
    "node-cron": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pageflip": "^2.0.3",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  }
}
